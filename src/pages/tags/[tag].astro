---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getPosts, tagSlug } from '../../utils';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const tags = new Map<string, string>(); // slug → 원래 표기
  for (const p of posts) for (const t of p.data.tags) tags.set(tagSlug(t), t);
  return [...tags.entries()].map(([slug, label]) => ({
    params: { tag: slug },
    props: { label, posts: posts.filter((p) => p.data.tags.some((t) => tagSlug(t) === slug)) },
  }));
}) satisfies GetStaticPaths;

const { label, posts } = Astro.props;
---
<BaseLayout title={`#${label}`}>
  <div class="container">
    <div class="page-head"><h1>#{label}</h1><p>글 {posts.length}개</p></div>
    <div class="with-sidebar">
      <section class="content">{posts.map((post) => <PostCard post={post} />)}</section>
      <Sidebar />
    </div>
  </div>
</BaseLayout>
