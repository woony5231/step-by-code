---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORIES } from '../../consts';
import { getPosts } from '../../utils';

const posts = await getPosts();
const list = CATEGORIES.map((c) => ({ ...c, count: posts.filter((p) => p.data.category === c.name).length }));
---
<BaseLayout title="카테고리">
  <div class="container" style="padding-bottom:64px">
    <div class="page-head"><h1>카테고리</h1><p>어떤 종류의 글인지로 나눴습니다.</p></div>
    <div class="box" style="max-width:560px">
      <ul>
        {list.map((c) => (
          <li><a href={`/category/${c.slug}/`}><span>{c.name}</span><span class="count">{c.count}개</span></a></li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>
