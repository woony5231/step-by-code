---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, GITHUB_URL } from '../consts';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean; // 검색 결과에 나오지 않게 할 페이지
}

const { title, description = SITE_DESCRIPTION, type = 'website', noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 썸네일은 반드시 전체 주소(https://...)여야 SNS가 읽을 수 있다
const ogImage = new URL('/og-default.png', Astro.site).href;
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: '홈', active: path === '/' || /^\/\d+\/?$/.test(path) },
  { href: '/category/', label: '카테고리', active: path.startsWith('/category') },
  { href: '/tags/', label: '태그', active: path.startsWith('/tags') },
  { href: '/search/', label: '검색', active: path.startsWith('/search') },
  { href: '/about/', label: '소개', active: path.startsWith('/about') },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="EDLleTkhxfMA80H8laoAhxWEcyEwSBLyWD7okzUmePY" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="ko_KR" />
    <!-- 공유 썸네일: 카카오톡·SNS 링크 미리보기 그림 (1200x630) -->
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <!-- 다크모드: 화면이 그려지기 전에 테마를 정해서 깜빡임을 막는다 -->
    <script is:inline>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="logo"><span class="logo-mark" aria-hidden="true">&gt;_</span>{SITE_TITLE}</a>
        <nav class="main-nav" aria-label="주 메뉴">
          {nav.map((item) => (
            <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
          ))}
          <button type="button" class="icon-btn" id="theme-toggle" aria-label="다크모드 전환">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} {SITE_TITLE}</span>
        <nav aria-label="하단 메뉴">
          <a href="/rss.xml">RSS</a>
          <a href={GITHUB_URL}>GitHub</a>
          <a href="/about/">소개</a>
          <a href="/stats/">통계</a>
        </nav>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>
